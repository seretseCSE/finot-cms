@props(['currentPage' => ''])

@php
    $resolvedPage = $currentPage;
    if (Request::is('announcements/*')) $resolvedPage = 'news';
    if (Request::is('events/*'))        $resolvedPage = 'news';
    if (Request::is('songs*'))          $resolvedPage = 'resources';
    if (Request::is('library*'))        $resolvedPage = 'resources';
    if (Request::is('media*'))          $resolvedPage = 'resources';
    if (Request::is('blog*'))           $resolvedPage = 'resources';
    if (Request::is('shop*'))           $resolvedPage = 'tours';
    if (Request::is('tours*'))          $resolvedPage = 'tours';
    if (Request::is('course*'))         $resolvedPage = 'course';
    if (Request::is('study*'))          $resolvedPage = 'study';
    if (Request::is('favorites*'))      $resolvedPage = 'favorites';
    if (Request::is('search*'))         $resolvedPage = 'search';

    /**
     * Pull urgent banner announcements from the DB.
     * Falls back to an empty collection if the table / model doesn't exist yet,
     * so the component never breaks during local development.
     */
    try {
        $bannerAnnouncements = \App\Models\Announcement::query()
            ->where('is_urgent', true)
            ->where('show_on_banner', true)
            ->where('expires_at', '>', now())
            ->orderByDesc('is_urgent')
            ->orderByDesc('created_at')
            ->get();
    } catch (\Throwable) {
        $bannerAnnouncements = collect();
    }
@endphp

{{-- {{-- ═══════════════════════════════════════════════════════════════
     0.  SMART NOTIFICATION BANNER
     ═══════════════════════════════════════════════════════════════ --}}
@if($bannerAnnouncements->isNotEmpty())
<div id="smart-banner" style="
    position:fixed;top:0;left:0;right:0;z-index:950;
    height:48px;overflow:hidden;
    transform:translateY(-100%);
    transition:transform .45s cubic-bezier(.22,1,.36,1);
" aria-live="polite" aria-atomic="true">

    {{-- Slides wrapper --}}
    <div id="banner-slides" style="position:relative;width:100%;height:100%;">
        @foreach($bannerAnnouncements as $i => $ann)
            @php
                $urgency = $ann->urgency ?? 'info'; // 'critical' | 'important' | 'info'
                [$bg, $accent] = match($urgency) {
                    'critical'  => ['linear-gradient(90deg,#b91c1c 0%,#dc2626 50%,#b91c1c 100%)', '#fca5a5'],
                    'important' => ['linear-gradient(90deg,#b45309 0%,#d97706 50%,#b45309 100%)', '#fcd34d'],
                    default     => ['linear-gradient(90deg,#1d4ed8 0%,#2563eb 50%,#1d4ed8 100%)', '#93c5fd'],
                };
                $icon = match($urgency) {
                    'critical'  => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
                    'important' => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>',
                    default     => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>',
                };
            @endphp
            <div class="banner-slide"
                 data-index="{{ $i }}"
                 data-urgency="{{ $urgency }}"
                 style="
                     position:absolute;inset:0;
                     background:{{ $bg }};
                     background-size:200% 100%;
                     display:flex;align-items:center;justify-content:center;
                     padding:0 56px 0 16px;
                     opacity:{{ $i === 0 ? 1 : 0 }};
                     transition:opacity .5s ease;
                     pointer-events:{{ $i === 0 ? 'auto' : 'none' }};
                 "
            >
                {{-- Shimmer overlay --}}
                <div style="
                    position:absolute;inset:0;pointer-events:none;overflow:hidden;
                    background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.08) 50%,transparent 60%);
                    background-size:200% 100%;
                    animation:banner-shimmer 3s linear infinite;
                "></div>

                {{-- Icon --}}
                <svg width="16" height="16" fill="none" stroke="{{ $accent }}" viewBox="0 0 24 24"
                     style="flex-shrink:0;margin-right:10px;opacity:.9;">
                    {!! $icon !!}
                </svg>

                {{-- Text --}}
                <span style="
                    color:#fff;font-size:.82rem;font-weight:500;letter-spacing:.01em;
                    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
                    max-width:calc(100% - 80px);
                ">
                    @if($ann->label ?? null)
                        <strong style="font-weight:700;margin-right:6px;color:{{ $accent }};">
                            {{ $ann->label }}
                        </strong>
                    @endif
                    {{ $ann->title }}
                    @if($ann->subtitle ?? null)
                        <span style="opacity:.8;margin-left:6px;">— {{ $ann->subtitle }}</span>
                    @endif
                </span>

                {{-- Dot indicators (only if multiple) --}}
                @if($bannerAnnouncements->count() > 1)
                    <div style="display:flex;gap:4px;margin-left:14px;flex-shrink:0;" id="banner-dots-{{ $i }}">
                        @foreach($bannerAnnouncements as $d => $_)
                            <span style="
                                width:5px;height:5px;border-radius:50%;
                                background:{{ $d === $i ? '#fff' : 'rgba(255,255,255,.35)' }};
                                transition:background .3s;
                            " data-dot="{{ $d }}"></span>
                        @endforeach
                    </div>
                @endif
            </div>
        @endforeach
    </div>

    {{-- Dismiss button --}}
    <button id="banner-dismiss" aria-label="{{ __('Dismiss banner') }}" style="
        position:absolute;right:12px;top:50%;transform:translateY(-50%);
        width:28px;height:28px;border-radius:50%;
        background:rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.25);
        color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;
        transition:background .2s,transform .2s;z-index:10;flex-shrink:0;
    ">
        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
</div>
@endif --}}

