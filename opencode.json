{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "@21st-dev/magic": {
            "type": "local",
            "command": ["npx", "-y", "@21st-dev/magic@latest"],
            "environment": {
                "API_KEY": "your-api-key-here"
            }
        }
    }
}